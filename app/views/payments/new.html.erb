<section class="min-h-[70vh] bg-gray-50 px-4 py-12">
  <div class="mx-auto max-w-xl rounded-3xl bg-white p-8 shadow-xl">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#9a784d]">Verified Documents</p>
    <h1 class="mt-2 text-3xl font-bold text-[#354041]">Unlock property documents</h1>
    <p class="mt-3 text-gray-600">
      Pay 1% of the property value once to unlock the verified document bundle.
    </p>

    <div class="my-8 rounded-2xl bg-gray-50 p-6">
      <div class="flex items-center justify-between">
        <span class="text-gray-600">Property</span>
        <span class="font-semibold text-[#354041]"><%= @property.title %></span>
      </div>
      <div class="mt-3 flex items-center justify-between">
        <span class="text-gray-600">Access fee</span>
        <span class="text-2xl font-extrabold text-[#354041]">₹<%= number_with_delimiter(@amount) %></span>
      </div>
    </div>

    <button id="razorpay-button" type="button"
            class="w-full rounded-xl bg-[#ccaa79] px-6 py-4 font-bold text-[#354041] hover:bg-[#b48f5c] disabled:opacity-60">
      Pay & unlock documents
    </button>
    <p id="payment-status" class="mt-4 text-center text-sm text-gray-500"></p>
  </div>
</section>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const button = document.getElementById("razorpay-button");
    const status = document.getElementById("payment-status");

    const options = {
      key: "<%= Rails.application.credentials.dig(:razorpay, :key_id) %>",
      amount: "<%= (@amount * 100).to_i %>",
      currency: "INR",
      name: "HamaraGroup",
      description: "Verified property document access",
      order_id: "<%= @razorpay_order_id %>",
      prefill: { email: "<%= current_user.email %>",
      theme: { color: "#354041" },
      handler: async function (response) {
        status.textContent = "Verifying your payment...";
        button.disabled = true;

        try {
          const result = await fetch("<%= verify_property_payment_path(@property, @payment) %>", {
            method: "POST",
            headers: {
              "X-CSRF-Token": "<%= form_authenticity_token %>",
              "Content-Type": "application/json",
              "Accept": "application/json"
            },
            body: JSON.stringify(response)
          });

          const data = await result.json();
          if (!result.ok || !data.success) throw new Error(data.message || "Payment verification failed.");

          window.location.href = data.redirect_url;
        } catch (error) {
          status.textContent = error.message;
          button.disabled = false;
        }
      }
    };

    const razorpay = new Razorpay(options);
    razorpay.on("payment.failed", function () {
      status.textContent = "Payment was not completed. Please try again.";
      button.disabled = false;
    });

    button.addEventListener("click", function () {
      button.disabled = true;
      razorpay.open();
    });
  });
</script>
