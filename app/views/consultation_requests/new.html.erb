<section class="min-h-screen bg-[#f7f4ef] px-4 py-12">
  <div class="mx-auto grid max-w-6xl overflow-hidden rounded-3xl bg-white shadow-xl md:grid-cols-2">
    <div class="relative min-h-[320px]">
      <img src="https://images.unsplash.com/photo-1656992469966-f046fa50420a?auto=format&fit=crop&w=1200&q=80"
           alt="HamaraGroup consultation" class="absolute inset-0 h-full w-full object-cover">
      <div class="absolute inset-0 bg-[#354041]/45"></div>
      <div class="absolute inset-x-0 bottom-0 p-8 text-white">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#d6ad72]">Expert guidance</p>
        <h1 class="mt-2 text-4xl font-bold">Let's talk about your property.</h1>
      </div>
    </div>

    <div class="p-8 md:p-10">
      <h2 class="text-2xl font-bold text-[#354041]">Request a consultation</h2>
      <p class="mt-2 text-gray-600">Tell us what you need and our team will get back to you.</p>

      <% if @consultation_request.errors.any? %>
        <div class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
          <ul class="list-disc list-inside">
            <% @consultation_request.errors.full_messages.each do |error| %>
              <li><%= error %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if flash[:notice] %>
        <div class="mt-6 rounded-xl border border-green-200 bg-green-50 p-4 text-sm font-semibold text-green-800">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <%= form_with url: consultation_requests_path, scope: :consultation_request, local: true,
                    class: "mt-6 space-y-4" do |f| %>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <%= f.text_field :first_name, placeholder: "First name *", required: true,
              class: "w-full rounded-xl border border-gray-300 px-4 py-3 focus:border-[#ccaa79] focus:outline-none" %>
          <%= f.text_field :last_name, placeholder: "Last name *", required: true,
              class: "w-full rounded-xl border border-gray-300 px-4 py-3 focus:border-[#ccaa79] focus:outline-none" %>
        </div>

        <%= f.email_field :email, placeholder: "Email address *", required: true,
            class: "w-full rounded-xl border border-gray-300 px-4 py-3 focus:border-[#ccaa79] focus:outline-none" %>

        <%= f.telephone_field :phone_number, placeholder: "Phone number *", required: true,
            class: "w-full rounded-xl border border-gray-300 px-4 py-3 focus:border-[#ccaa79] focus:outline-none" %>

        <% if @property %>
          <div class="rounded-xl bg-gray-50 px-4 py-3 text-sm text-gray-600">
            Consultation for: <span class="font-semibold text-[#354041]"><%= @property.title %></span>
          </div>
        <% end %>

        <%= f.text_area :message, placeholder: "How can we help? *", required: true, rows: 5,
            class: "w-full resize-none rounded-xl border border-gray-300 px-4 py-3 focus:border-[#ccaa79] focus:outline-none" %>

        <%= f.submit "Send inquiry",
            class: "w-full rounded-xl bg-[#354041] px-6 py-4 font-bold text-white hover:bg-black" %>
      <% end %>
    </div>
  </div>
</section>
